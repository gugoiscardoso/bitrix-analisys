# ─── Dados regeneráveis ───────────────────────────────────────────
# Exports brutos do Bitrix: ~85 MB e crescendo a cada coleta.
# Recuperáveis a qualquer momento com:  dotnet run --project ... -- --mode all --from <data>
data/raw/

# Base histórica: 15 MB hoje, cresce todo mês. Reconstruída por
# pipeline/consolidar_store.py a partir de data/raw/.
data/store/base_historica.jsonl

# NÃO ignorar data/store/classificacao.json nem taxonomia.json:
# a classificação custou ~1,3 milhão de tokens e não é recuperável de outra forma.

# Arquivos da análise exploratória que originaram o store canônico.
# Mantidos localmente por rastreabilidade; a consolidação já foi comprovada.
data/store/_legado/

# Fila de trabalho do classificador — transitória, some após 'absorver'.
data/store/_fila/

# Espaço pessoal: análises e arquivos de trabalho que não interessam ao time.
local/

# ─── Saída ────────────────────────────────────────────────────────
# Gerada de forma determinística pelo pipeline: mesmo período, mesmo arquivo.
report/

# ─── Build e temporários ──────────────────────────────────────────
bin/
obj/
__pycache__/
*.pyc

# Arquivos de bloqueio do Excel (aparecem quando a planilha está aberta)
~$*.xlsx

# Área de trabalho da auditoria de amostra: regerada a cada execução do /build-report
data/store/_auditoria/

# Lotes e respostas da auditoria de 07/08/2026: 8,5 MB de JSON reprodutível pelos
# scripts ao lado. Os scripts ficam versionados; o material bruto, não.
pipeline/_auditoria/lotes/
pipeline/_auditoria/reclass/
pipeline/_auditoria/respostas/
pipeline/_auditoria/respostas_v1_viciada/
pipeline/_auditoria/prompts/

# Lotes e respostas da classificação não-fiscal (regeráveis, ~30 MB)
pipeline/_naofiscal/*/lote_*.json
pipeline/_naofiscal/*/resp_*.json
pipeline/_naofiscal/*/amostra.json
pipeline/_naofiscal/lote_*.json
pipeline/_naofiscal/resp_*.json
pipeline/_naofiscal/amostra.json

# Derivados grandes da leitura de 30/10/2026. Ficam de fora por tamanho (19 MB e
# 50 MB), e só porque dá para refazer:
#   remetentes.json    quem falou cada mensagem — `python pipeline/enriquecer_autores.py`
#                      (~55 min de API; incremental, retoma de onde parou)
#   transcricoes.json  conversa legível — sai de `consolidar_store.py` em ~4 min
# leitura_completa.json NÃO entra aqui: é julgamento de leitura, não se regenera.
data/store/remetentes.json
data/store/transcricoes.json

# Espelho da planilha do CronJob do N1 (4 MB cada, e crescendo ~37 conversas por dia).
# Fica de fora porque é cópia de fonte externa, refeita em segundos:
#   python pipeline/coletar_n1.py
# classificacao_n1.json NÃO entra aqui, pelo mesmo motivo que leitura_completa.json: é
# julgamento de leitura e não se regenera. Como ele é indexado por id de conversa, a
# classificação sobrevive a qualquer recoleta.
# O risco conhecido: se algum dia o N1 podar linhas antigas da planilha, o espelho
# encolhe junto e o histórico só existe no que já foi publicado. Se isso virar problema,
# o lugar de resolver é um snapshot datado, não o git.
data/store/n1_conversas.jsonl
data/store/n1_transcricoes.json

# ─── Segredos que NÃO entram no git ───────────────────────────────
# local/sheets.env tem a chave privada da conta de serviço do Google
# (ultracar-report-chat-ai@…), que escreve em toda planilha compartilhada
# com ela — inclusive a do N1. O id da planilha, que não é segredo, fica
# versionado no appsettings. Para repor num clone novo, veja o README.
local/
