# ─── Dados regeneráveis ───────────────────────────────────────────
# Exports brutos do Bitrix: ~85 MB e crescendo a cada coleta.
# Recuperáveis a qualquer momento com:  dotnet run --project ... -- --mode all --from <data>
data/raw/

# Base histórica: 15 MB hoje, cresce todo mês. Reconstruída por
# pipeline/consolidar_store.py a partir de data/raw/.
data/store/base_historica.jsonl

# NÃO ignorar data/store/classificacao.json nem taxonomia.json:
# a classificação custou ~1,3 milhão de tokens e não é recuperável de outra forma.

# Arquivos da análise exploratória que originaram o store canônico.
# Mantidos localmente por rastreabilidade; a consolidação já foi comprovada.
data/store/_legado/

# Fila de trabalho do classificador — transitória, some após 'absorver'.
data/store/_fila/

# Espaço pessoal: análises e arquivos de trabalho que não interessam ao time.
local/

# ─── Saída ────────────────────────────────────────────────────────
# Gerada de forma determinística pelo pipeline: mesmo período, mesmo arquivo.
report/

# ─── Build e temporários ──────────────────────────────────────────
bin/
obj/
__pycache__/
*.pyc

# Arquivos de bloqueio do Excel (aparecem quando a planilha está aberta)
~$*.xlsx

# Área de trabalho da auditoria de amostra: regerada a cada execução do /build-report
data/store/_auditoria/

# Lotes e respostas da auditoria de 07/08/2026: 8,5 MB de JSON reprodutível pelos
# scripts ao lado. Os scripts ficam versionados; o material bruto, não.
pipeline/_auditoria/lotes/
pipeline/_auditoria/reclass/
pipeline/_auditoria/respostas/
pipeline/_auditoria/respostas_v1_viciada/
pipeline/_auditoria/prompts/
